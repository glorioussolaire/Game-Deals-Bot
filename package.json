{
  "name": "telegram-wishlist-deals",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Private Thailand-aware Steam wishlist discount alerts across authorized retailers.",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test test/engine.test.js test/sources.test.js test/monitor.test.js test/storage.test.js test/config.test.js test/security.test.js test/commands.test.js",
    "check": "node scripts/check.mjs",
    "configure": "node scripts/configure.mjs",
    "preview": "node scripts/run.mjs",
    "send": "node scripts/run.mjs --send",
    "check:live": "node scripts/live.mjs",
    "add:2game": "node scripts/add-two-game.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "dev": "node scripts/wrangler.mjs dev --test-scheduled",
    "build": "node scripts/wrangler.mjs deploy --dry-run --outdir dist",
    "login": "node scripts/wrangler.mjs login",
    "deploy": "node scripts/deploy.mjs",
    "logs": "node scripts/wrangler.mjs tail"
  },
  "devDependencies": { "wrangler": "^4.0.0" }
}
